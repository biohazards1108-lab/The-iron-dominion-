# Iron Dominion / Bedrock Dominion API configuration template
# This backend is legacy reference code and is NOT ready for Bedrock Dominion.
# Copy to .env only for local testing. Never commit real credentials.

PORT=3000
API_PORT=3000
NODE_ENV=development

# Keep false unless the API is behind exactly one trusted reverse proxy.
TRUST_PROXY=false

# The website is static; do not use it as an API endpoint.
PUBLIC_SITE_URL=https://irondominion.com
API_BASE_URL=

# SQLite database path (local development only)
DB_PATH=../data/irondom.db

# Server connection values intentionally blank until the actual server is configured.
MC_SERVER_IP=
MC_RCON_HOST=
MC_RCON_PORT=
MC_RCON_PASSWORD=

# Legacy shop is disabled by default. Do not enable for Bedrock Dominion.
SHOP_ENABLED=false
SHOP_DELIVERY_METHOD=disabled

# Legacy token economy values are inactive until a supported backend is implemented.
TOKEN_STARTING_BALANCE=0
TOKEN_MAX_BALANCE=999999

# Generate unique random secrets for local testing; never reuse account passwords.
INTERNAL_API_KEY=REPLACE_WITH_A_RANDOM_SECRET_AT_LEAST_32_CHARACTERS
ADMIN_API_KEY=REPLACE_WITH_A_DIFFERENT_RANDOM_SECRET_AT_LEAST_32_CHARACTERS

# Only list origins that genuinely need API access. Leave blank by default.
ALLOWED_ORIGINS=

# Community
DISCORD_INVITE=https://discord.gg/bnXXc2ng72

LOG_LEVEL=info
