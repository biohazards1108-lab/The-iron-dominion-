# Iron Dominion Server API configuration
# Copy to .env and replace every placeholder marked REPLACE_.
# NEVER commit .env, API keys, database files, or RCON passwords.

PORT=3000
API_PORT=3000
NODE_ENV=production

# Temporary public site / API reference while the real .com domain is unavailable.
# GitHub Pages can host the static site, but it CANNOT execute the Node API.
PUBLIC_SITE_URL=https://biohazards1108-lab.github.io/The-iron-dominion-/
API_BASE_URL=https://biohazards1108-lab.github.io/The-iron-dominion-/

# SQLite database path
DB_PATH=../data/irondom.db

# Minecraft server information
MC_SERVER_IP=the-iron-dominion-dev.g.akliz.net
MC_RCON_HOST=your-server-ip
MC_RCON_PORT=25575
MC_RCON_PASSWORD=REPLACE_your_secure_rcon_password

# Shop settings
SHOP_ENABLED=true
SHOP_DELIVERY_METHOD=mail

# Token economy
TOKEN_STARTING_BALANCE=500
TOKEN_MAX_BALANCE=999999

# API security
# Generate long random values; never reuse passwords.
INTERNAL_API_KEY=REPLACE_generate_a_random_32_plus_character_key
ADMIN_API_KEY=REPLACE_generate_a_different_random_32_plus_character_admin_key

# Browser origins allowed to call the API. Leave blank if the browser never
# calls protected endpoints directly. Never use '*' in production.
ALLOWED_ORIGINS=https://biohazards1108-lab.github.io

# Discord community
DISCORD_INVITE=https://discord.gg/bnXXc2ng72

# Logging
LOG_LEVEL=info
