# Iron Dominion Server Configuration
# Copy this to .env and fill in your values

# Server
PORT=3000
NODE_ENV=production

# Database
DB_PATH=./data/irondom.db

# Minecraft Server
MC_SERVER_IP=the-iron-dominion-dev.g.akliz.net
MC_RCON_HOST=your-server-ip
MC_RCON_PORT=25575
MC_RCON_PASSWORD=your_secure_rcon_password

# Shop Settings
SHOP_ENABLED=true
SHOP_DELIVERY_METHOD=mail

# Token Economy
TOKEN_STARTING_BALANCE=500
TOKEN_MAX_BALANCE=999999

# API
API_PORT=3000
API_HOST=0.0.0.0

# Logging
LOG_LEVEL=info
